        "import random\n",
        "import time\n",
        "\n",
        "# Generate data acak 20 elemen\n",
        "random.seed(42)\n",
        "harga_produk = [random.randint(5000, 50000) for _ in range(20)]\n",
        "\n",
        "# Pendekatan A: O(N^2)\n",
        "start_a = time.perf_counter()\n",
        "max_a = harga_produk[0]\n",
        "for i in range(len(harga_produk)):\n",
        "    is_max = True\n",
        "    for j in range(len(harga_produk)):\n",
        "        if harga_produk[j] > harga_produk[i]:\n",
        "            is_max = False\n",
        "            break\n",
        "    if is_max:\n",
        "        max_a = harga_produk[i]\n",
        "end_a = time.perf_counter()\n",
        "waktu_a = end_a - start_a\n",
        "\n",
        "# Pendekatan B: O(N)\n",
        "start_b = time.perf_counter()\n",
        "max_b = harga_produk[0]\n",
        "for harga in harga_produk:\n",
        "    if harga > max_b:\n",
        "        max_b = harga\n",
        "end_b = time.perf_counter()\n",
        "waktu_b = end_b - start_b\n",
        "\n",
        "print(\"=== Nomor 5b: Hasil Pengukuran Waktu Eksekusi ===\")\n",
        "print(f\"Nilai Maksimum: Rp{max_b}\")\n",
        "print(f\"Waktu Pendekatan A (O(N^2)): {waktu_a:.8f} detik\")\n",
        "print(f\"Waktu Pendekatan B (O(N))  : {waktu_b:.8f} detik\")"
      ]
    }
